# ── WattWise environment configuration ──────────────────────────────────────
# Copy this file to .env and fill in values for your local setup.
# NEVER commit .env to version control.

# Database — local SQLite file path (default: data/wattwise.db)
# WATTWISE_DATABASE_URL=data/wattwise.db

# Secret key for JWT signing — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset in .env.example — MUST be set in your actual .env
WATTWISE_SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY

# JWT token expiry in minutes (default: 60)
# WATTWISE_TOKEN_EXPIRE_MINUTES=60

# Electricity tariff in INR per kWh (default: 8.50)
# WATTWISE_TARIFF_INR_PER_KWH=8.50

# Waste detection thresholds
# WATTWISE_RESIDUAL_THRESHOLD_KW=10.0
# WATTWISE_OCCUPANCY_THRESHOLD=5

# Simulator polling interval in seconds (default: 30)
# WATTWISE_SIMULATOR_INTERVAL=30

# Enable debug mode (shows extra logs, do NOT use in production)
# WATTWISE_DEBUG=false

# Max login attempts per minute per IP (default: 10)
# WATTWISE_LOGIN_RATE_LIMIT=10
